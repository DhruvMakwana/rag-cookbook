# Copy this file to .env in the same folder (or anywhere above it). Never
# commit .env.

# This recipe drives both PageIndex's tree construction/reasoning and the
# naive-RAG baseline's generation with Anthropic models.
ANTHROPIC_API_KEY=

# Optional: point at your own PDF instead of the default NIST AI RMF
# sample. It needs genuine hierarchical structure (headings, sections,
# a real table of contents) for PageIndex to have anything to navigate --
# see README for why "Attention Is All You Need" wasn't used here.
# PDF_PATH=/absolute/path/to/your.pdf
