# Copy this file to .env in the same folder (or anywhere above it) and fill
# in your keys. Never commit .env.

# This recipe's agent loop uses Anthropic's native tool-calling API
# directly (not the pluggable llm.py used elsewhere in this repo) —
# tool-calling request/response shapes differ enough across providers
# that there's no honest single abstraction here. Anthropic only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Needed for the web_search tool — free tier, no credit card:
# https://tavily.com
TAVILY_API_KEY=

# Optional: point at your own PDF instead of the default sample.
# PDF_PATH=/absolute/path/to/your.pdf
