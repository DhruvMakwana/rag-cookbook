# Copy this file to .env in the same folder (or anywhere above it). Never
# commit .env.

# "anthropic" | "openai" -- image-grounded generation needs a vision-
# capable provider.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: point at your own video instead of the default NASA sample.
# VIDEO_PATH=/absolute/path/to/your.mp4
