# Copy this file to .env in the same folder (or anywhere above it) and fill
# in only the keys for the provider(s) you plan to use. Never commit .env.

# "anthropic" | "openai" — Vision RAG's generation step needs a vision-capable
# provider. Ollama isn't supported for --mode vision (see README).
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: point at your own PDF instead of the default sample.
# PDF_PATH=/absolute/path/to/your.pdf
