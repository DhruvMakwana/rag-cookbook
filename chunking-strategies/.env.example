# Copy this file to .env in the same folder (or anywhere above it) and fill
# in only the keys for the provider(s) you plan to use. Never commit .env.

# "anthropic" | "openai" | "ollama"
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama needs no API key — just a local server running.
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.1

# Optional: point at your own PDF instead of the default sample.
# PDF_PATH=/absolute/path/to/your.pdf
