# Copy this file to .env in the same folder (or anywhere above it). Never
# commit .env.

# This recipe only uses Anthropic -- CAG's cache_control mechanism (the
# thing actually being measured) has no equivalent explicit control on
# OpenAI's automatic caching. See README for why.
ANTHROPIC_API_KEY=

# Optional: point at your own PDF instead of the default sample. Must be
# small enough that its full extracted text fits in the model's context
# window -- CAG loads the whole document, not chunks of it.
# PDF_PATH=/absolute/path/to/your.pdf
